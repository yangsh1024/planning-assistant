/* ===== CSS Custom Properties ===== */
page {
  --bg: #F0F9FF;
  --surface: #FFFFFF;
  --surface-2: #E0F2FE;
  --border: #BAE6FD;
  --border-2: #E0F2FE;
  --accent: #0EA5E9;
  --accent-mid: #38BDF8;
  --accent-bg: #E0F2FE;
  --text: #0C1A2B;
  --text-2: #475569;
  --text-3: #94A3B8;
  --danger: #EF4444;
  --danger-bg: #FEF2F2;
  --warning: #F59E0B;
  --success: #10B981;
  --expense: #F97316;

  background-color: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

/* ===== Reset ===== */
view, text, image, input, textarea, button {
  box-sizing: border-box;
}

/* ===== Typography ===== */
.text-xs   { font-size: 22rpx; }
.text-sm   { font-size: 24rpx; }
.text-base { font-size: 28rpx; }
.text-lg   { font-size: 32rpx; }
.text-xl   { font-size: 36rpx; }
.text-2xl  { font-size: 40rpx; }
.text-3xl  { font-size: 48rpx; }

.font-medium { font-weight: 500; }
.font-semibold { font-weight: 600; }
.font-bold { font-weight: 700; }

.text-muted  { color: var(--text-3); }
.text-secondary { color: var(--text-2); }
.text-accent { color: var(--accent); }
.text-danger { color: var(--danger); }
.text-success { color: var(--success); }
.text-warning { color: var(--warning); }
.text-expense { color: var(--expense); }

/* ===== Layout utilities ===== */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.items-center { align-items: center; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.flex-1 { flex: 1; }
.gap-8 { gap: 8rpx; }
.gap-16 { gap: 16rpx; }

/* ===== Spacing ===== */
.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }
.px-16 { padding-left: 16rpx; padding-right: 16rpx; }
.py-16 { padding-top: 16rpx; padding-bottom: 16rpx; }
.mt-8  { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mb-16 { margin-bottom: 16rpx; }

/* ===== Card ===== */
.card {
  background: var(--surface);
  border: 1rpx solid var(--border-2);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
}

/* ===== Buttons ===== */
.btn-primary {
  width: 100%;
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-mid) 100%);
  color: #fff;
  border: none;
  border-radius: 24rpx;
  padding: 30rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1;
}

.btn-primary::after { border: none; }

.btn-ghost {
  width: 100%;
  background: transparent;
  color: var(--text-3);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 28rpx;
  font-size: 30rpx;
  text-align: center;
  line-height: 1;
}

.btn-ghost::after { border: none; }

/* ===== Form elements ===== */
.form-group { margin-bottom: 32rpx; }

.form-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 16rpx;
}

.form-row {
  width: 100%;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  font-size: 28rpx;
  color: var(--text);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-row-arrow {
  color: var(--text-3);
  font-size: 24rpx;
}

/* ===== Progress bar ===== */
.progress-bar {
  height: 8rpx;
  background: var(--surface-2);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 4rpx;
  background: var(--accent-mid);
  transition: width 0.3s ease;
}

.progress-fill.warning { background: var(--warning); }
.progress-fill.danger  { background: var(--danger); }

/* ===== Divider ===== */
.divider {
  height: 1rpx;
  background: var(--border-2);
  margin: 16rpx 0;
}

/* ===== Safe area ===== */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
