/* components/state-view/state-view.wxss */
.state-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
}

.state-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spinner-ring {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--border-2);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

.state-empty,
.state-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.state-icon {
  font-size: 80rpx;
  line-height: 1;
}

.state-message {
  font-size: 28rpx;
  color: var(--text-3);
  text-align: center;
  line-height: 1.6;
}

.retry-btn {
  margin-top: 16rpx;
  padding: 16rpx 48rpx;
  background: var(--accent-bg);
  color: var(--accent);
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.retry-btn:active {
  opacity: 0.8;
}
