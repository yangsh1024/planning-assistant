.page{padding:64rpx 32rpx;color:var(--text)}.title,.device,.tip{display:block}.title{font-size:40rpx;font-weight:700}.device{margin:32rpx 0 16rpx;font-size:30rpx}.tip{color:var(--text-2);margin-bottom:40rpx}.primary{background:var(--accent);color:#fff;margin-bottom:16rpx}.divider{text-align:center;color:var(--text-3);margin:48rpx 0 24rpx}input{width:100%;height:96rpx;border:1rpx solid var(--border);border-radius:12rpx;padding:0 24rpx;margin-bottom:16rpx;font-size:32rpx;line-height:96rpx;text-align:center}
