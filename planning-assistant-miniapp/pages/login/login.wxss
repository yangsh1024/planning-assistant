/* pages/login/login.wxss */
page {
  background: linear-gradient(160deg, #0EA5E9 0%, #38BDF8 60%, #E0F2FE 100%);
  min-height: 100vh;
}

.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 48rpx 60rpx;
}

.login-hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.app-logo {
  width: 140rpx;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 16rpx 48rpx rgba(14, 165, 233, 0.3);
}

.app-logo-image {
  width: 124rpx;
  height: 124rpx;
  border-radius: 62rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.app-tagline {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  line-height: 1.6;
}

.login-card {
  width: 100%;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 24rpx 64rpx rgba(14, 165, 233, 0.2);
}

.login-desc {
  font-size: 26rpx;
  color: var(--text-3);
  text-align: center;
  margin-bottom: 36rpx;
  line-height: 1.6;
}

.btn-wechat {
  width: 100%;
  background: #07C160;
  color: #fff;
  border: none;
  border-radius: 20rpx;
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
}

.btn-wechat::after {
  border: none;
}

.login-footer {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 32rpx;
}

.footer-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.footer-link {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.95);
  text-decoration: underline;
}
