/* pages/profile/profile.wxss */
page {
  background-color: var(--bg);
}

.profile-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Hero */
.profile-hero {
  background: linear-gradient(160deg, var(--accent) 0%, var(--accent-mid) 100%);
  padding: 48rpx 32rpx 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.avatar-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: rgba(255, 255, 255, 0.25);
  border: 4rpx solid rgba(255, 255, 255, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-image { width: 112rpx; height: 112rpx; border-radius: 56rpx; }

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.profile-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* Scroll */
.profile-scroll {
  flex: 1;
  overflow: hidden;
}

/* Menu sections */
.menu-section {
  padding: 24rpx 24rpx 0;
}

.section-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
  letter-spacing: 0.5rpx;
  margin-bottom: 12rpx;
  padding-left: 4rpx;
}

.menu-group {
  background: var(--surface);
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--border-2);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border-2);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--accent-bg);
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.icon-blue { background: var(--accent-bg); }
.icon-green { background: #ECFDF5; }
.icon-orange { background: #FFF7ED; }
.icon-red { background: var(--danger-bg); }

.menu-label {
  font-size: 28rpx;
  color: var(--text);
}

.menu-arrow {
  font-size: 28rpx;
  color: var(--text-3);
}

.modal-mask { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; background: rgba(12, 26, 43, 0.5); }
.profile-modal { width: 100%; max-height: calc(100vh - env(safe-area-inset-bottom)); box-sizing: border-box; padding: 40rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; overflow-y: auto; background: var(--surface); }
.modal-title { display: block; text-align: center; font-size: 32rpx; font-weight: 600; color: var(--text); }
.modal-desc { display: block; margin: 12rpx 0 28rpx; text-align: center; font-size: 24rpx; color: var(--text-3); }
.avatar-picker { margin-bottom: 24rpx; }
.avatar-options { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12rpx 0; }
.avatar-option { box-sizing: border-box; width: 31.5%; padding: 8rpx 4rpx; border: 2rpx solid transparent; border-radius: 16rpx; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.avatar-option-selected { border-color: var(--accent); background: var(--accent-bg); }
.avatar-option-image { width: 72rpx; height: 72rpx; border-radius: 36rpx; }
.avatar-option-label { font-size: 20rpx; color: var(--text-2); line-height: 1.4; }
.avatar-option-selected .avatar-option-label { color: var(--accent); font-weight: 600; }
.profile-field { padding: 20rpx 24rpx; border: 1rpx solid var(--border); border-radius: 16rpx; background: var(--surface); }
.profile-field-label { display: block; margin-bottom: 10rpx; font-size: 22rpx; color: var(--text-3); }
.profile-input { box-sizing: border-box; width: 100%; height: 44rpx; font-size: 28rpx; color: var(--text); }
.modal-primary { width: 100%; margin-top: 24rpx; font-size: 28rpx; border-radius: 16rpx; color: #fff; background: var(--accent); }
.modal-primary::after { border: none; }
.modal-cancel { margin-top: 16rpx; padding: 20rpx; text-align: center; font-size: 28rpx; color: var(--text-3); }
.contact-modal { align-items: center; display: flex; flex-direction: column; }
.contact-qr { width: 360rpx; height: 360rpx; margin: -4rpx 0 20rpx; }
.contact-text { display: block; color: var(--text-2); font-size: 28rpx; line-height: 1.6; }

.scroll-padding {
  height: 120rpx;
}
