/* pages/expense/add/add.wxss */
page {
  background-color: var(--bg);
}

.add-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.form-header {
  text-align: center;
  padding: 24rpx 32rpx 20rpx;
  border-bottom: 1rpx solid var(--border-2);
  background: var(--surface);
  flex-shrink: 0;
}

.form-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}

.form-scroll {
  flex: 1;
  overflow: hidden;
}

/* Amount section */
.amount-section {
  background: var(--surface);
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border-2);
}

.amount-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 20rpx;
}

/* Form body */
.form-body {
  padding: 32rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 16rpx;
}

.note-input {
  width: 100%;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  font-size: 28rpx;
  color: var(--text);
  min-height: 120rpx;
  line-height: 1.6;
}

.note-placeholder {
  color: var(--text-3);
}

.field-error {
  display: block;
  margin-top: 12rpx;
  color: var(--danger);
  font-size: 22rpx;
}

.amount-error {
  margin: 16rpx 0;
}

.custom-category-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 10rpx 10rpx 10rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  background: var(--surface);
}

.custom-category-input {
  flex: 1;
  height: 56rpx;
  font-size: 26rpx;
  color: var(--text);
}

.custom-category-btn {
  padding: 14rpx 28rpx;
  border-radius: 16rpx;
  background: var(--accent);
  color: #fff;
  font-size: 24rpx;
}

.btn-primary {
  margin-bottom: 0;
}

.btn-delete {
  width: 100%;
  background: var(--danger-bg);
  color: var(--danger);
  border: 1rpx solid #FECACA;
  border-radius: 20rpx;
  padding: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1;
  margin-top: 16rpx;
}

.btn-delete::after {
  border: none;
}

.scroll-padding {
  height: 80rpx;
}
