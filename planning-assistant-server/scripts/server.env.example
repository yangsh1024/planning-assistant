# 服务器部署环境变量模板。复制为 ${APP_HOME}/conf/server.env 后填写真实值，并执行 chmod 600。
# 所有变量均由 scripts/start-server.sh 加载；不要将真实文件提交到仓库。

export APP_HOME=/opt/planning-assistant
export JAR_FILE=/opt/planning-assistant/app/planning-assistant-app-1.0.0-SNAPSHOT.jar
export RUN_DIR=/opt/planning-assistant/run
export LOG_DIR=/opt/planning-assistant/logs

# JDK 21。留空时脚本使用 PATH 中的 java。
export JAVA_HOME=/usr/lib/jvm/temurin-21-jdk

# Spring Boot / 数据库
export SERVER_PORT=18081
export DB_URL='jdbc:mysql://127.0.0.1:3306/planning_assistant?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true'
export DB_USERNAME=planning_app
export DB_PASSWORD=''

# 微信与安全配置。JWT_SECRET 必须是至少 32 字节随机密钥的 Base64 编码。
export WECHAT_APPID=''
export WECHAT_SECRET=''
export JWT_SECRET=''

# 可按服务器内存调优；不在此处加入任何密钥。
export JAVA_OPTS='-Xms256m -Xmx512m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai'
